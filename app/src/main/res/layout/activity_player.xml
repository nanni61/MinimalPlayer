<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Player video con controlli nativi ExoPlayer -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_timeout="3000"
        app:controller_layout_id="@layout/player_controls" />

    <!-- HUD in alto: ora corrente → ora fine (sinistra) e trascorso/totale (destra) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:layout_gravity="top">

        <TextView
            android:id="@+id/tvHudLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--:-- → --:--"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#AA000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/tvHudRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--:-- / --:--"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end"
            android:shadowColor="#AA000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />

    </LinearLayout>

    <!-- Overlay centrale per seek / volume / luminosità -->
    <TextView
        android:id="@+id/tvOverlay"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#BB000000"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:lineSpacingMultiplier="1.3" />

</FrameLayout>
